# ===== 段 A 必填（缺失 → 启动拒绝，00 硬门槛 11）=====
DATABASE_URL=postgresql+asyncpg://aitutors:change-me@localhost:5432/aitutors
APP_ENV=development

# ===== EB-008 review proof 密钥（92号 §5.2）=====
# ≥32 字节；缺失时启动拒绝（非 test 环境）+ proof 生成/验证 fail-closed。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=

# ===== future configuration surface（段 C 接线后才 required；段 A 默认 disabled 不要求 token）=====
# LLM Gateway（段 C）
LLM_GATEWAY_MODE=disabled
# cloud OCR（段 C external 闸后，段 B 接线：OCRGateway 三态；disabled/mock 不要求 token）
OCR_GATEWAY_MODE=disabled
PADDLEOCR_VL_TOKEN=
PADDLEOCR_API_BASE_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
PADDLEOCR_POLL_INTERVAL_SECONDS=5.0
PADDLEOCR_TIMEOUT_SECONDS=300.0
# 本地 LLM / embedding（段 C/B 后）
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIMENSION=2560
# 对象存储（段 B 后）
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false
# 管理端点首次引入时提升为 required（段 A 无 admin endpoint，不校验）
ADMIN_API_KEY=
